datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

enum StoreTier {
  STARTER
  PRO
  ADVANCE
}

enum ProductStatus {
  AVAILABLE
  BOOKED
  SOLD
}

model Store {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  customDomain String?       @unique
  whatsapp     String
  address      String?
  mapsUrl      String?
  tier         StoreTier     @default(STARTER)
  templateId   String        @default("default")
  primaryColor String        @default("#2563eb")
  logoUrl      String?
  bannerUrl    String?
  hasWatermark Boolean       @default(false)
  lastTemplateChangeAt DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  products     Product[]
  tradeInOffers TradeInOffer[]

  @@index([slug])
  @@index([customDomain])
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  name          String
  brand         String
  price         Int
  ramRom        String
  batteryHealth Int?
  imeiStatus    String        // e.g. "Kemenperin / All Operator", "Smartfren Only", "Bea Cukai", "WiFi Only"
  completeness  String        // e.g. "Fullset Original", "Unit Only (Batangan)", "Fullset OEM"
  condition     String        // e.g. "98% Mulus Like New", "95% Pemakaian Wajar"
  minusNotes    String?       // e.g. "TrueTone Off", "Layar pernah ganti ori", "No minus mulus"
  status        ProductStatus @default(AVAILABLE)
  clickCount    Int           @default(0)
  images        String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
}

model TradeInOffer {
  id            String   @id @default(cuid())
  storeId       String
  customerName  String
  customerWa    String
  deviceModel   String
  expectedPrice Int?
  conditionDesc String
  minusNotes    String?
  photoUrls     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}
