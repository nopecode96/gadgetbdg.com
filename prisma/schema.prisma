datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// ============================================================
// ENUMS
// ============================================================

enum StoreTier {
  STARTER
  PRO
  ADVANCE
}

enum ProductStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum Role {
  SUPER_ADMIN
  ADMIN_SAAS
  SALES_AGENT
  STORE_OWNER
  STORE_STAFF
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  PAID
}

// ============================================================
// MODELS
// ============================================================

model Store {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  customDomain String?       @unique
  whatsapp     String
  address      String?
  storeImage      String?
  mapsUrl         String?
  googleReviewUrl String?
  operationalHours String?      @default("Setiap Hari: 10:00 - 20:30 WIB")
  warrantyPolicy  String?       @default("Garansi Toko 30 Hari Replace Unit & Jaminan Bebas Blokir IMEI Seumur Hidup.")
  verifiedBadge   Boolean       @default(false)
  tier            StoreTier     @default(STARTER)
  templateId      String        @default("default")
  primaryColor    String        @default("#2563eb")
  logoUrl         String?
  bannerUrl       String?
  hasWatermark    Boolean       @default(false)
  lastTemplateChangeAt DateTime?
  isActive        Boolean       @default(false)
  subscriptionExpiresAt DateTime?
  salesUserId     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  salesUser     User?                 @relation("SalesStoreRelation", fields: [salesUserId], references: [id], onDelete: SetNull)
  products      Product[]
  tradeInOffers TradeInOffer[]
  users         User[]
  branches      Branch[]
  payments      SubscriptionPayment[]
  commissions   SalesCommissionLog[]
  reviews       StoreReview[]

  @@index([slug])
  @@index([customDomain])
  @@index([salesUserId])
}

model StoreReview {
  id            String   @id @default(cuid())
  storeId       String
  customerName  String
  rating        Int      @default(5)
  comment       String
  purchasedUnit String?
  isApproved    Boolean  @default(true)
  createdAt     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Branch {
  id          String    @id @default(cuid())
  storeId     String
  name        String    // Contoh: "BEC Lantai 1 Blok C-05"
  address     String    // Alamat lengkap rute fisik
  phone       String?   // No WA spesifik cabang
  mapsUrl     String?   // Link Google Maps cabang
  isMain      Boolean   @default(false) // Cabang pusat
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products    Product[]
  users       User[]

  @@index([storeId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STORE_STAFF)
  storeId      String?
  branchId     String?
  referralCode String?  @unique
  bankName     String?
  bankNumber   String?
  bankHolder   String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientStores Store[]              @relation("SalesStoreRelation")
  commissions  SalesCommissionLog[]

  @@index([email])
  @@index([storeId])
  @@index([branchId])
  @@index([referralCode])
}

model Product {
  id            String        @id @default(cuid())
  storeId       String
  branchId      String?
  name          String
  brand         String
  price         Int
  ramRom        String
  batteryHealth Int?
  imeiStatus    String        // e.g. "Kemenperin / All Operator", "Smartfren Only", "Bea Cukai", "WiFi Only"
  completeness  String        // e.g. "Fullset Original", "Unit Only (Batangan)", "Fullset OEM"
  condition     String        // e.g. "98% Mulus Like New", "95% Pemakaian Wajar"
  minusNotes    String?       // e.g. "TrueTone Off", "Layar pernah ganti ori", "No minus mulus"
  status        ProductStatus @default(AVAILABLE)
  clickCount    Int           @default(0)
  images        String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([branchId])
  @@index([status])
}

model TradeInOffer {
  id            String   @id @default(cuid())
  storeId       String
  customerName  String
  customerWa    String
  deviceModel   String
  expectedPrice Int?
  conditionDesc String
  minusNotes    String?
  photoUrls     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model SubscriptionPayment {
  id          String               @id @default(cuid())
  storeId     String
  tier        StoreTier
  amount      Int
  receiptUrl  String?
  status      PaymentStatus        @default(PENDING)
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  commissions SalesCommissionLog[]

  @@index([storeId])
  @@index([status])
}

model SalesCommissionLog {
  id          String           @id @default(cuid())
  salesUserId String
  storeId     String
  paymentId   String
  tier        StoreTier
  amount      Int
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  salesUser   User                @relation(fields: [salesUserId], references: [id], onDelete: Cascade)
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payment     SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([salesUserId])
  @@index([storeId])
  @@index([paymentId])
  @@index([status])
}

