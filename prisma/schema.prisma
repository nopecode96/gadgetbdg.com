datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

// ============================================================
// ENUMS
// ============================================================

enum StoreTier {
  STARTER
  PRO
  ADVANCE
}

enum ProductStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum Role {
  SUPER_ADMIN
  ADMIN_SAAS
  SALES
  SALES_AGENT
  STORE_OWNER
  STORE_STAFF
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum TradeInStatus {
  PENDING
  CONTACTED
  DEAL
  REJECTED
}

// ============================================================
// MODELS
// ============================================================

model Store {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  customDomain           String?   @unique
  customDomainStatus     String?   @default("PENDING") // PENDING, ACTIVE, FAILED
  customDomainVerifiedAt DateTime?
  customDomainDnsType    String?   @default("CNAME") // CNAME atau A
  whatsapp     String
  address      String?
  storeImage      String?
  mapsUrl         String?
  googleReviewUrl String?
  operationalHours String?      @default("Setiap Hari: 10:00 - 20:30 WIB")
  warrantyPolicy  String?       @default("Garansi Toko 30 Hari Replace Unit & Jaminan Bebas Blokir IMEI Seumur Hidup.")
  verifiedBadge   Boolean       @default(false)
  tier            StoreTier     @default(STARTER)
  planId          String        @default("STARTER")
  templateId      String        @default("default")
  template        String        @default("minimal-clean")
  primaryColor    String        @default("#2563eb")
  logoUrl         String?
  bannerUrl       String?
  hasWatermark    Boolean       @default(false)
  lastTemplateChangeAt DateTime?
  isActive        Boolean       @default(false)
  isDemo          Boolean       @default(false)

  // Konfigurasi Hero Banner Promosi Beranda
  promoBannerActive   Boolean   @default(true)
  promoBannerBadge    String?   @default("PROMO SPESIAL")
  promoBannerTitle    String?   @default("Diskon Unit Flagship Siap COD")
  promoBannerSubtitle String?   @default("Lolos uji kelayakan, garansi replace unit dan jaminan IMEI aman seumur hidup.")
  promoBannerImage    String?   // URL foto unit/banner promosi
  promoBannerCtaText  String?   @default("Lihat Promo")
  promoBannerCtaLink  String?   @default("/katalog")
  subscriptionStartedAt DateTime? @default(now())
  subscriptionExpiresAt DateTime?
  salesUserId     String?
  referredBySalesId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  plan             SubscriptionPlan      @relation(fields: [planId], references: [id])
  salesUser        User?                 @relation("SalesStoreRelation", fields: [salesUserId], references: [id], onDelete: SetNull)
  referredBySales  SalesPartner?         @relation("StoreSalesPartner", fields: [referredBySalesId], references: [id], onDelete: SetNull)
  products         Product[]
  tradeInOffers    TradeInOffer[]
  tradeInLeads     TradeInLead[]
  users            User[]
  branches         Branch[]
  payments         SubscriptionPayment[]
  commissions      SalesCommissionLog[]
  salesCommissions SalesCommission[]
  reviews          StoreReview[]

  @@index([slug])
  @@index([customDomain])
  @@index([planId])
  @@index([salesUserId])
  @@index([referredBySalesId])
}

model StoreReview {
  id            String    @id @default(cuid())
  storeId       String
  branchId      String?   // Null jika ulasan toko umum/pusat, terisi jika ulasan gerai cabang
  customerName  String
  rating        Int       @default(5)
  comment       String
  purchasedUnit String?
  isApproved    Boolean   @default(true)
  reviewDate    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([branchId])
}

model Branch {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  name            String        // Contoh: "Cabang BEC Lantai 1"
  slug            String        // Contoh: "bec" (untuk subdomain: bec.domainanda.com atau /cabang/bec)
  address         String        // Alamat lengkap rute fisik
  whatsapp        String        // No WhatsApp hotline kasir/admin cabang
  phone           String?       // Backward compatibility field
  mapsUrl         String?       // Backward compatibility field
  isMain          Boolean       @default(false)

  // Field Profil & Identitas Fisik Cabang (Setara Store)
  image           String?       // Foto fisik konter gerai (Rasio 16:9 hasil upload)
  googleMapsUrl   String?       // URL Petunjuk Arah Google Maps
  googleReviewUrl String?       // URL Ulasan Google Bisnis
  businessHours   String?       // Contoh: "Setiap Hari: 10:00 - 21:00 WIB"
  warrantyInfo    String?       // Ketentuan garansi & layanan cabang

  // Relasi ke Data Lain
  products        Product[]     // Unit HP yang dialokasikan di cabang ini
  users           User[]        // Staf/Kasir yang bertugas di cabang ini
  tradeIns        TradeInLead[] // Leads tukar tambah yang dialokasikan ke cabang ini
  reviews         StoreReview[] // Relasi ulasan khusus cabang ini

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STORE_STAFF)
  storeId      String?
  branchId     String?
  referralCode String?  @unique
  bankName     String?
  bankNumber   String?
  bankHolder   String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salesPartner SalesPartner?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientStores Store[]              @relation("SalesStoreRelation")
  commissions  SalesCommissionLog[]

  @@index([email])
  @@index([storeId])
  @@index([branchId])
  @@index([referralCode])
}

model Product {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  // Info Utama
  title           String         @default("") // Contoh: "iPhone 13 Pro 256GB Sierra Blue"
  slug            String         @default("")
  category        String         @default("SMARTPHONE") // SMARTPHONE, TABLET, ACCESSORY, SMARTWATCH
  brand           String         // Apple, Samsung, Xiaomi, Oppo, Vivo, dll.
  price           Decimal        @db.Decimal(12, 2)
  
  // Multi-Foto (Galeri Sudut HP)
  images          String[]       @default([]) // Array URL foto (depan, belakang, sudut lecet, kelengkapan)
  
  // Spesifikasi Fleksibel (Textbox Bebas)
  grade           String?        // Contoh: "Grade A+ (Mulus Like New)"
  ram             String?        // Contoh: "8GB" / "8GB + 8GB"
  storage         String?        // Contoh: "256GB"
  batteryHealth   String?        // Contoh: "88% Original" / "Awet Seharian"
  completeness    String?        // Contoh: "Fullset Box Original" / "Unit Only"
  
  // Catatan Minus & Kondisi Riil
  conditionNotes  String?        // Contoh: "Ada dent halus di bezel kanan atas, TrueTone ON, 3uTools hijau semua"
  description     String?        // Keterangan tambahan garansi toko / bonus case
  
  // Status Stok & Home Flags
  status          ProductStatus  @default(AVAILABLE) // AVAILABLE, BOOKED, SOLD
  clickCount      Int            @default(0)
  isFeatured      Boolean        @default(false) // Unit Pilihan Minggu Ini
  isReadyCod      Boolean        @default(true)  // Rekomendasi Siap COD Hari Ini

  // Backward compatibility fields
  name            String?
  ramRom          String?
  condition       String?
  minusNotes      String?
  imeiStatus      String?
  warrantyBonus   String?
  thumbnail       String?
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId])
  @@index([branchId])
  @@index([status])
  @@index([category])
  @@index([slug])
}

model TradeInOffer {
  id            String        @id @default(cuid())
  storeId       String
  customerName  String
  customerPhone String?
  customerWa    String        // Keep for backward compat
  phoneModel    String?
  deviceModel   String        // Keep for backward compat
  condition     String?
  conditionDesc String        // Keep for backward compat
  batteryHealth Int?
  imeiStatus    String?
  completeness  String?
  minusNotes    String?
  expectedPrice Int?
  photoUrls     String[]      @default([])
  status        TradeInStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
}

model TradeInLead {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  // Jenis Transaksi: "TRADE_IN" atau "SELL_ONLY"
  type               String   @default("TRADE_IN")
  
  // Kontak Pengunjung (Aset Leads Toko)
  customerName       String
  customerPhone      String
  
  // Rincian HP Lama
  deviceModel        String   // contoh: iPhone 12 128GB
  condition          String   // LIKE_NEW, NORMAL, MINUS
  completeness       String   // FULLSET, UNIT_ONLY
  notes              String?  // Catatan minus / BH
  
  // Ekspektasi Harga: "APPRAISAL_REQUEST" atau "EXPECTED_PRICE"
  pricingType        String   @default("APPRAISAL_REQUEST")
  expectedPrice      Float?   // Nominal jika customer punya ekspektasi
  
  // Target Unit (jika TRADE_IN)
  targetProductId    String?
  targetProductTitle String?
  
  // Status Follow-up di Admin Toko: PENDING, FOLLOW_UP, DEAL, CANCELLED
  status             String   @default("PENDING")
  adminNotes         String?  // Catatan internal kasir/admin toko
  
  // Cabang tujuan trade-in/cek fisik
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([storeId])
  @@index([branchId])
  @@index([status])
  @@index([type])
}

model SubscriptionPayment {
  id          String               @id @default(cuid())
  storeId     String
  tier        StoreTier
  planId      String?
  amount      Int
  receiptUrl  String?
  status      PaymentStatus        @default(PENDING)
  notes       String?
  paidAt         DateTime?
  reviewedByName String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan?    @relation(fields: [planId], references: [id])
  commissions SalesCommissionLog[]

  @@index([storeId])
  @@index([planId])
  @@index([status])
}

model SubscriptionPlan {
  id                      String                @id // "STARTER", "PRO", "ADVANCE"
  name                    String                // "Starter", "Pro", "Advance"
  labelBadge              String                // "STARTER • PERINTIS", etc.
  tagline                 String
  price                   Decimal               @db.Decimal(12, 2)
  originalPrice           Decimal               @db.Decimal(12, 2)
  discountBadge           String?
  popularBadge            String?
  period                  String                @default("/ bulan")
  maxActiveProducts       Int                   // 15, 30, 999999
  maxAdmins               Int                   // 1, 3, 5
  availableTemplatesCount Int                   // 2, 4, 6
  templateCooldownDays    Int                   // -1, 30, 0
  templateChangeRule      String                @default("Hanya 1x saat pendaftaran")
  hasWatermark            Boolean               @default(false)
  hasQrWebsite            Boolean               @default(true)
  hasQrGoogleReview       Boolean               @default(false)
  hasStoryMaker           Boolean               @default(false)
  hasCustomDomain         Boolean               @default(false)
  customDomain            Boolean               @default(false)
  salesCommission         Decimal               @default(0) @db.Decimal(12, 2)
  features                Json?
  reportsLevel            String                @default("BASIC_WA") // "BASIC_WA", "SOLD_LEADERBOARD", "BRANCH_FULL"
  description             String?
  stores                  Store[]
  payments                SubscriptionPayment[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model PlatformSetting {
  id                String   @id @default("GLOBAL")
  platformName      String   @default("GadgetBdg.com")
  tagline           String   @default("Platform Toko Online Konter HP Terpercaya")
  cityCoverage      String   @default("Bandung Raya")
  heroTitle         String   @default("Buka Web Toko HP Konter Anda Sendiri Dalam 5 Menit")
  heroSubtitle      String   @default("Tingkatkan penjualan unit second & baru, kelola tukar tambah, dan miliki katalog modern tanpa repot koding.")
  supportWhatsapp   String   @default("62895389974414")
  supportEmail      String   @default("support@gadgetbdg.com")

  // Finansial
  enableBankTransfer Boolean  @default(false)
  bankName           String?  @default("BCA")
  bankAccountNumber  String?  @default("1234567890")
  bankAccountHolder  String?  @default("PT Gadget Bandung Solusindo")
  qrisImageUrl       String?  @default("/uploads/platform/qris-official.png")
  qrisNmid           String?  @default("ID1026592057644")

  // Teknis
  serverIp          String   @default("72.62.75.149")
  cnameTarget       String   @default("cname.gadgetbdg.com")

  updatedAt         DateTime @updatedAt
}

model SalesCommissionLog {
  id          String           @id @default(cuid())
  salesUserId String
  storeId     String
  paymentId   String
  tier        StoreTier
  amount      Int
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  salesUser   User                @relation(fields: [salesUserId], references: [id], onDelete: Cascade)
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payment     SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([salesUserId])
  @@index([storeId])
  @@index([paymentId])
  @@index([status])
}

model SalesPartner {
  id            String            @id @default(cuid())
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String            @unique // e.g. "ANDI-BEC"
  name          String
  phone         String
  bankName      String?           // BCA, Mandiri, BRI, dll
  bankAccount   String?           // Nomor rekening
  bankHolder    String?           // Nama pemilik rekening
  isActive      Boolean           @default(true)
  stores        Store[]           @relation("StoreSalesPartner")
  commissions   SalesCommission[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([code])
}

model SalesCommission {
  id             String           @id @default(cuid())
  salesPartnerId String
  salesPartner   SalesPartner     @relation(fields: [salesPartnerId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  amount         Decimal          @db.Decimal(12, 2) // Rp 50.000 (Starter), Rp 100.000 (Pro), Rp 150.000 (Advance)
  status         CommissionStatus @default(PENDING) // PENDING, PAID, CANCELLED
  period         String           // e.g. "2026-10"
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([salesPartnerId])
  @@index([storeId])
  @@index([status])
  @@index([period])
}

